<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist on iOS. Xcode has no INFOPLIST_KEY_ build
	     setting for this key, so it lives here: it shows Documents (the mods folder) in
	     the Files app. Checked by Scripts/check-files-app.sh. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
